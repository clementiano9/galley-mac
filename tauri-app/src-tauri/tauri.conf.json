{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galley",
  "version": "0.1.0",
  "identifier": "com.clementozemoya.galley",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galley",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost http: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "$HOME/.ssh/**",
            "$HOME/.aws/**",
            "$HOME/.gnupg/**",
            "$HOME/Library/Keychains/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A lightweight markdown viewer for AI power users",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdc"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": ["txt"],
        "name": "Plain Text Document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ]
  }
}
