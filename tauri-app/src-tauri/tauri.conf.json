{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tiny-viewer",
  "version": "0.1.0",
  "identifier": "com.clementozemoya.tiny-viewer",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tiny-viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "Productivity",
    "shortDescription": "A lightweight markdown viewer for AI power users",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
